{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Key": "",
    "Issuer": "StudentInfoSystem",
    "Audience": "StudentInfoSystemUsers"
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "student-route": {
        "ClusterId": "student-cluster",
        "Match": {
          "Path": "/api/student/{**catch-all}"
        },
        "AuthorizationPolicy": "AuthenticatedUser"
      },
      "grade-route": {
        "ClusterId": "grade-cluster",
        "Match": {
          "Path": "/api/grade/{**catch-all}"
        },
        "AuthorizationPolicy": "AuthenticatedUser"
      },
      "schedule-route": {
        "ClusterId": "schedule-cluster",
        "Match": {
          "Path": "/api/schedule/{**catch-all}"
        },
        "AuthorizationPolicy": "AuthenticatedUser"
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:10001"
          }
        }
      },
      "student-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:10002"
          }
        }
      },
      "grade-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:10003"
          }
        }
      },
      "schedule-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:10004"
          }
        }
      }
    }
  },
  "Security": {
    "GatewaySecret": ""
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:10000"
      },
      "Https": {
        "Url": "https://localhost:10010"
      }
    }
  }
}